flowchart TD
  subgraph Actors["👥 External Entities"]
    Guardian["👤 Guardian<br/>(Parent)"]
    Staff["👨‍⚕️ Clinic Staff<br/>(Nurse/CHW)"]
    Manager["🏢 Manager<br/>(BM/HQ)"]
    PublicUser["🌍 Public<br/>User"]
    SMSGateway["📱 SMS<br/>Gateway"]
    EmailSvc["📧 Email<br/>Service"]
  end

  subgraph P1["🔐 P1: Authentication & Authorization"]
    Login["1.1 Validate<br/>Credentials"]
    JWT["1.2 Issue<br/>JWT Token"]
    RoleRoute["1.3 Route to<br/>Role Dashboard"]
  end

  subgraph P2["👶 P2: Child Registration & Enrollment"]
    RegChild["2.1 Capture<br/>Child & Guardian<br/>Details"]
    GenID["2.2 Generate<br/>CVCC ID<br/>+ QR Code"]
    SyncQ["2.3 Queue &<br/>Sync Offline<br/>Data"]
  end

  subgraph P3["💉 P3: Vaccination Management"]
    ViewSched["3.1 Load<br/>Vaccination<br/>Schedule"]
    RecordDose["3.2 Record<br/>Dose<br/>Administered"]
    IssueCert["3.3 Issue or<br/>Update<br/>Certificate"]
  end

  subgraph P4["📬 P4: Notifications & Reminders"]
    Scheduler["4.1 Daily<br/>Scheduler<br/>(Cron)"]
    BuildMsg["4.2 Build<br/>Reminder<br/>Message"]
    Dispatch["4.3 Dispatch<br/>SMS or<br/>Email"]
  end

  subgraph P5["📊 P5: Reporting & Administration"]
    Analytics["5.1 Branch<br/>Analytics<br/>+ KPIs"]
    AuditLog["5.2 Audit<br/>Log Trail"]
    UserMgmt["5.3 User &<br/>Branch<br/>Management"]
  end

  subgraph DS["💾 Data Stores"]
    DS1[("DS1: users<br/>branches")]
    DS2[("DS2: children<br/>guardians<br/>child_guardian")]
    DS3[("DS3: vaccines<br/>vaccination_events<br/>certificates")]
    DS4[("DS4: notifications<br/>templates")]
    DS5[("DS5: audit_logs<br/>settings")]
  end

  Guardian -->|"credentials"| Login
  Staff -->|"credentials"| Login
  Manager -->|"credentials"| Login
  Login <-->|"query"| DS1
  DS1 -->|"user + role"| JWT
  JWT --> RoleRoute
  RoleRoute -->|"auth token"| Guardian
  RoleRoute -->|"auth token"| Staff
  RoleRoute -->|"auth token"| Manager

  Staff -->|"mother & child<br/>info"| RegChild
  RegChild <-->|"read/write"| DS2
  DS2 -->|"saved record"| GenID
  GenID -->|"CVCC ID<br/>+ QR"| DS2
  GenID -->|"offline data"| SyncQ
  SyncQ <-->|"sync"| DS2

  Staff -->|"open child<br/>chart"| ViewSched
  DS3 -->|"schedule<br/>+ history"| ViewSched
  ViewSched -->|"due vaccines"| Staff
  Staff -->|"dose details<br/>+ batch no"| RecordDose
  RecordDose <-->|"record"| DS3
  DS3 -->|"all doses<br/>complete?"| IssueCert
  IssueCert <-->|"create/update"| DS3
  IssueCert -->|"certificate"| Guardian

  Scheduler -->|"fetch due<br/>children"| DS3
  DS3 -->|"due list"| BuildMsg
  DS2 -->|"guardian phone<br/>+ email"| BuildMsg
  BuildMsg -->|"message<br/>payload"| Dispatch
  Dispatch -->|"appointment<br/>reminders"| SMSGateway
  Dispatch -->|"staff invites"| EmailSvc
  SMSGateway -->|"delivery<br/>status"| DS4
  EmailSvc -->|"delivery<br/>status"| DS4

  Manager -->|"request<br/>report"| Analytics
  DS3 -->|"vaccination<br/>data"| Analytics
  DS2 -->|"child counts"| Analytics
  Analytics -->|"KPIs<br/>+ charts"| Manager
  DS5 <-->|"audit trail"| AuditLog
  AuditLog -->|"filtered<br/>logs"| Manager
  Manager -->|"create/update<br/>user"| UserMgmt
  UserMgmt <-->|"write"| DS1

  PublicUser -->|"certificate ID"| ViewSched
  DS3 -->|"certificate<br/>status"| PublicUser

  classDef actor fill:#f0f4ff,stroke:#5a67d8,stroke-width:2px
  classDef process fill:#fff5f5,stroke:#e53e3e,stroke-width:2px
  classDef datastore fill:#f7fafc,stroke:#2d3748,stroke-width:2px
  class Guardian,Staff,Manager,PublicUser,SMSGateway,EmailSvc actor
  class Login,JWT,RoleRoute,RegChild,GenID,SyncQ,ViewSched,RecordDose,IssueCert,Scheduler,BuildMsg,Dispatch,Analytics,AuditLog,UserMgmt process
  class DS1,DS2,DS3,DS4,DS5 datastore
