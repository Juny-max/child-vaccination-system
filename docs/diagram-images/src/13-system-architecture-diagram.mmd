flowchart TD
  subgraph Client["📱 Client Layer<br/>Browser & Mobile Web"]
    ReactUI["React UI<br/>5 Role-Based<br/>Dashboards<br/>+ /verify Page"]
    IndexedDB["💾 IndexedDB<br/>Offline<br/>Storage"]
    ServiceWorker["⚙️ Service Worker<br/>Background<br/>Sync"]
  end

  subgraph NextJS["🎨 Frontend Layer<br/>Next.js 16 on Vercel"]
    AppRouter["📄 App Router<br/>/app/** pages<br/>20+ routes"]
    NextAPIRoutes["🔌 API Routes<br/>/api/verify<br/>/api/chatbot"]
    AuthMiddleware["🔐 Auth<br/>Middleware<br/>JWT Protection"]
    LibAPI["📡 lib/api/<br/>helpers<br/>Bearer token"]
  end

  subgraph NestJS["🔧 Backend Layer<br/>NestJS on Render<br/>Port 3001"]
    AuthMod["🔐 Auth Module<br/>JWT, Guards<br/>Role-based"]
    ParentMod["👤 Parent<br/>Module"]
    FacilityMod["🏥 Facility<br/>Module"]
    CHWMod["🏃 CHW<br/>Module"]
    BranchMod["🏢 Branch<br/>Manager Module"]
    HQMod["🏛️ HQ Admin<br/>Module"]
    Common["🛠️ Common<br/>Services<br/>Email, SMS<br/>Scheduler<br/>Backup"]
  end

  subgraph DataLayer["💾 Data Layer<br/>Supabase PostgreSQL"]
    SupabaseDB["21 Tables<br/><br/>users, children<br/>vaccines, events<br/>certificates<br/>appointments<br/>audit_logs, etc."]
  end

  subgraph External["🌐 External<br/>Services"]
    Brevo["📧 Brevo<br/>Email"]
    Hubtel["📱 Hubtel<br/>SMS"]
    Gemini["🤖 Google<br/>Gemini<br/>AI Chatbot"]
  end

  ReactUI --> AppRouter
  ReactUI <-->|"read/write"| IndexedDB
  ServiceWorker <-->|"read/write"| IndexedDB
  AppRouter --> AuthMiddleware
  AppRouter --> LibAPI
  AppRouter --> NextAPIRoutes
  AuthMiddleware --> LibAPI

  NextAPIRoutes -->|"Direct query"| SupabaseDB
  LibAPI --> AuthMod

  AuthMod --> ParentMod
  AuthMod --> FacilityMod
  AuthMod --> CHWMod
  AuthMod --> BranchMod
  AuthMod --> HQMod

  ParentMod --> SupabaseDB
  FacilityMod --> SupabaseDB
  CHWMod --> SupabaseDB
  BranchMod --> SupabaseDB
  HQMod --> SupabaseDB

  Common --> Brevo
  Common --> Hubtel
  ServiceWorker --> AuthMod
  AppRouter --> Gemini

  classDef clientStyle fill:#f0f4ff,stroke:#5a67d8,stroke-width:2px
  classDef frontendStyle fill:#fff5f5,stroke:#e53e3e,stroke-width:2px
  classDef backendStyle fill:#f7fafc,stroke:#2d3748,stroke-width:2px
  classDef dataStyle fill:#fffaf0,stroke:#c05621,stroke-width:2px
  classDef externalStyle fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px
  class ReactUI,IndexedDB,ServiceWorker clientStyle
  class AppRouter,NextAPIRoutes,AuthMiddleware,LibAPI frontendStyle
  class AuthMod,ParentMod,FacilityMod,CHWMod,BranchMod,HQMod,Common backendStyle
  class SupabaseDB dataStyle
  class Brevo,Hubtel,Gemini externalStyle
