  HQ --> HQ2[Manage users, branches, vaccines, audit logs]
  M --> N[Save locally if offline]
  N --> O[Sync when online]
  K --> P[Save updates]
  L --> P
  O --> P
  BM2 --> P
  HQ2 --> P
  P --> Q[Send notification if needed]
  Q --> R([End])
